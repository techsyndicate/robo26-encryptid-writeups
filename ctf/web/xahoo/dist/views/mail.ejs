<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xahoo - Inbox</title>
    <style>
        * {box-sizing: border-box;}
        body {
            margin: 0;
            font-family: system-ui, -apple-system, sans-serif;
            background: #e8e8e8;
            color: #222;
        }
        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 2rem;
            background: #fff;
            border-bottom: 1px solid #ddd;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-weight: 700;
            font-size: 1.2rem;
        }
        .brand .mark {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #555;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
        }
        .navBtns {display: flex; gap: 0.6rem;}
        .navBtns button {
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-size: 0.88rem;
            font-weight: 600;
            font-family: inherit;
            background: #fff;
            color: #222;
            cursor: pointer;
        }
        .navBtns button:hover {background: #f0f0f0;}
        .main {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }
        .heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }
        .heading h2 {
            margin: 0;
            font-size: 1.4rem;
        }
        .heading .count {
            color: #888;
            font-size: 0.9rem;
        }
        .mailList {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }
        .mailItem {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.25rem;
            cursor: pointer;
            transition: background .15s;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: inherit;
        }
        .mailItem:last-child {border-bottom: none;}
        .mailItem:hover {background: #fafafa;}
        .avatar {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e0e0e0;
            color: #444;
            font-weight: 600;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            text-transform: uppercase;
        }
        .mailInfo {flex: 1; min-width: 0;}
        .mailRow {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: baseline;
        }
        .mailFrom {
            font-weight: 700;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .mailDate {
            flex-shrink: 0;
            font-size: 0.8rem;
            color: #888;
        }
        .mailSubject {
            font-size: 0.9rem;
            color: #888;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 0.15rem;
        }
        .empty {
            text-align: center;
            padding: 4rem 1.5rem;
            color: #888;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
        }
        @media (max-width: 560px) {
            nav {padding: 0.9rem 1.25rem;}
            .main {padding: 0 1rem;}
        }
    </style>
</head>
<body>
    <nav>
        <div class="brand">
            <div class="mark">X</div>
            Xahoo
        </div>
        <div class="navBtns">
            <button onclick="window.location.href = '/key'">View Key</button>
            <button onclick="window.location.href = '/logout'">Logout</button>
        </div>
    </nav>
    <div class="main">
        <div class="heading">
            <h2>Inbox</h2>
            <span class="count"><%= mail.length %> message(s)</span>
        </div>
        <% if (mail.length === 0) { %>
            <div class="empty">Your inbox is empty</div>
        <% } else { %>
            <div class="mailList">
                <% for (let i = 0; i < mail.length; i++) { %>
                <a class="mailItem" href="/mail/<%= mail[i].id %>">
                    <div class="avatar"><%= mail[i].from.charAt(0) %></div>
                    <div class="mailInfo">
                        <div class="mailRow">
                            <span class="mailFrom"><%= mail[i].from %></span>
                            <span class="mailDate"><%= new Date(Number(mail[i].date)).toLocaleString() %></span>
                        </div>
                        <div class="mailSubject"><%= mail[i].subject %></div>
                    </div>
                </a>
                <% } %>
            </div>
        <% } %>
    </div>
</body>
</html>
