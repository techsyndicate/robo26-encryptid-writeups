<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= mail.subject %></title>
    <style>
        * {box-sizing: border-box;}
        body {
            margin: 0;
            font-family: system-ui, -apple-system, sans-serif;
            background: #e8e8e8;
            color: #222;
        }
        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 2rem;
            background: #fff;
            border-bottom: 1px solid #ddd;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-weight: 700;
            font-size: 1.2rem;
        }
        .brand .mark {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #555;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
        }
        .navBtns {display: flex; gap: 0.6rem;}
        .navBtns button {
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-size: 0.88rem;
            font-weight: 600;
            font-family: inherit;
            background: #fff;
            color: #222;
            cursor: pointer;
        }
        .navBtns button:hover {background: #f0f0f0;}
        .main {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }
        .mailCard {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }
        .mailHead {
            padding: 1.5rem 1.75rem;
            border-bottom: 1px solid #eee;
        }
        .mailSubject {
            margin: 0 0 1.25rem;
            font-size: 1.3rem;
            line-height: 1.3;
        }
        .senderRow {
            display: flex;
            align-items: center;
            gap: 0.9rem;
        }
        .avatar {
            flex-shrink: 0;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #e0e0e0;
            color: #444;
            font-weight: 600;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            justify-content: center;
            text-transform: uppercase;
        }
        .senderInfo {min-width: 0;}
        .senderName {
            font-weight: 700;
            font-size: 1rem;
        }
        .senderMeta {
            font-size: 0.85rem;
            color: #888;
            margin-top: 0.1rem;
            overflow-wrap: anywhere;
        }
        .bodyWrap {
            padding: 1.75rem;
            font-size: 0.95rem;
            line-height: 1.65;
        }
        .bodyWrap img {max-width: 100%;}
        .attachments {
            padding: 0 1.75rem 1.75rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
        }
        .attachments h3 {
            width: 100%;
            margin: 0;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #888;
        }
        .attachment {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.55rem 1rem;
            background: #fafafa;
            border: 1px solid #ccc;
            border-radius: 6px;
            color: #222;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 600;
        }
        .attachment:hover {background: #f0f0f0;}
        .backBtn {
            display: inline-block;
            margin-bottom: 1rem;
            color: #888;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
        }
        .backBtn:hover {color: #222;}
        @media (max-width: 560px) {
            nav {padding: 0.9rem 1.25rem;}
            .main {padding: 0 1rem;}
            .bodyWrap {padding: 1.25rem;}
        }
    </style>
</head>
<body>
    <nav>
        <div class="brand">
            <div class="mark">X</div>
            Xahoo
        </div>
        <div class="navBtns">
            <button onclick="window.location.href = '/mail'">Back to inbox</button>
        </div>
    </nav>
    <div class="main">
        <% let newdate = new Date(Number(mail.date)) %>
        <a class="backBtn" href="/mail">&larr; Back to inbox</a>
        <div class="mailCard">
            <div class="mailHead">
                <h2 class="mailSubject"><%= mail.subject %></h2>
                <div class="senderRow">
                    <div class="avatar"><%= mail.from.charAt(0) %></div>
                    <div class="senderInfo">
                        <div class="senderName"><%= mail.from %></div>
                        <div class="senderMeta">to <%= mail.to %> &middot; <%= newdate.toLocaleString() %></div>
                    </div>
                </div>
            </div>
            <div class="bodyWrap">
                <%- mail.data %>
            </div>
            <% if (mail.attachments.length > 0) { %>
                <div class="attachments">
                    <h3>Attachments</h3>
                    <% for (let i = 0; i < mail.attachments.length; i++) { %>
                        <a class="attachment" href="<%= mail.attachments[i] %>" target="_blank">Attachment <%= i + 1 %></a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
